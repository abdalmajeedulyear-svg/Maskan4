<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"


    app:cardBackgroundColor="@android:color/white">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tvTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="33dp"
        android:layout_marginTop="135dp"
        android:layout_marginStart="178dp"
        android:gravity="center"
        android:paddingHorizontal="5dp"
        android:text="للإيجار"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        app:backgroundTint="#FF9800"
        app:cornerRadius="12dp"
        app:elevation="2dp"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp"
        android:layout_margin="10dp"
        android:layout_marginTop="20dp">

        <!-- ✅ صورة العقار -->
        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/image_container_background">

            <!-- شريط التقييم -->
            <ImageView
                android:id="@+id/ivProperty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="صورة العقار"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/rating_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star_filled"
                    android:tint="#FFD700" />

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="4.8"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- زر المفضلة -->
          <!--  <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorite"
android:paddingLeft="1dp"
                android:layout_width="28dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:contentDescription="إضافة إلى المفضلة"
                app:backgroundTint="#AD898C88"
                app:cornerRadius="16dp"
                app:elevation="2dp"
                app:icon="@drawable/ic_favorite_border_white"
                app:iconTint="@color/background_white" />-->



        </FrameLayout>

        <!-- ✅ شارة النوع (للإيجار/للبيع) -->

        <!-- ✅ محتوى النص -->
        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/imageContainer"
            android:layout_alignParentTop="true"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <!-- العنوان -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="فيلا فاخرة مع مسبح خاص"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- الموقع -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_location_pin"
                    android:tint="#666666" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="حي النخيل، الرياض - قريب من المركز التجاري"
                    android:textColor="#666666"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- السعر -->
            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/price_background"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="1,200,000 ر.س"
                android:textColor="#2196F3"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- المواصفات -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- الغرف -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_bed"
                        android:tint="#4CAF50" />

                    <TextView
                        android:id="@+id/tvBedrooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="4"
                        android:textColor="#4CAF50"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="غرف"
                        android:textColor="#666666"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- الحمامات -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_bath"
                        android:tint="#FF9800" />

                    <TextView
                        android:id="@+id/tvBathrooms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="3"
                        android:textColor="#FF9800"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="حمام"
                        android:textColor="#666666"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- المساحة -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_area"
                        android:tint="#9C27B0" />

                    <TextView
                        android:id="@+id/tvArea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="250"
                        android:textColor="#9C27B0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="م²"
                        android:textColor="#666666"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ✅ شريط الإجراءات السفلي (يشمل أزرار التقييم والمشاركة والاتصال والحذف) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/contentLayout"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- زر التقييم -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRate"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"

                android:textColor="#FF9800"
                android:textSize="12sp"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_star_outline"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="#FF9800"
                app:strokeColor="#FF9800"
                app:strokeWidth="1dp" />

            <!-- زر المشاركة -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"

                android:textColor="#2196F3"
                android:textSize="12sp"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="#2196F3"
                app:strokeColor="#2196F3"
                app:strokeWidth="1dp" />

            <!-- زر الاتصال -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContact"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"

                android:textColor="#4CAF50"
                android:textSize="12sp"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="#4CAF50"
                app:strokeColor="#4CAF50"
                app:strokeWidth="1dp" />

            <!-- زر الحذف -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:textColor="#FF3B30"
                android:textSize="12sp"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="18dp"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:strokeColor="#D5062E"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="@android:color/holo_red_dark"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorite"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text=""
                android:textSize="12sp"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="18dp"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:strokeColor="#757575"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_heart_outline"
                app:iconTint="#757575"/>


        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>